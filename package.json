{
  "name": "CanvasRun",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build:client && wrangler deploy",
    "build:client": "cd client && npm install && npm run build",
    "db:create": "wrangler d1 create canvas-run-dev",
    "db:init": "wrangler d1 execute canvas-run-dev --file=./src/db/schema.sql",
    "db:init:prod": "wrangler d1 execute canvas-run-prod --file=./src/db/schema.sql --env production"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "cacheDirectories": [
    "node_modules",
    "client/node_modules"
  ],
  "dependencies": {
    "hono": "^4.10.3",
    "nanoid": "^5.1.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251004.0",
    "wrangler": "^4.42.0"
  }
}
